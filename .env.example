# ─────────────────────────────────────────────────────────────────────────────
# Artemis - Variáveis de Ambiente para Produção
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env no Git!
# ─────────────────────────────────────────────────────────────────────────────

# Configurações do Banco de Dados
DB_ROOT_PASSWORD=sua_senha_root_mysql_aqui
DB_NAME=artemis_db
DB_USER=artemis_user
DB_PASSWORD=sua_senha_usuario_mysql_aqui

# Segurança da API
JWT_SECRET=sua_chave_jwt_super_secreta_e_longa_aqui

# Configurações de Domínio e HTTPS
DOMAIN=caiozaccarias.com.br
LETSENCRYPT_EMAIL=seu_email@exemplo.com
